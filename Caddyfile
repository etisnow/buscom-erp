# HTTPS-фронт для админки. Домен берётся из ERP_DOMAIN (.env.production).
# Caddy сам получает и продлевает сертификат Let's Encrypt — для этого
# на сервер должны быть открыты порты 80 и 443, а домен указывать на него.

{$ERP_DOMAIN} {
	encode zstd gzip

	# Вебхук сайта приходит с подписью HMAC и проверяется в приложении;
	# отдельного ограничения по IP здесь нет — см. docs/DEPLOY.md.
	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 10
		}
	}

	# Админка не для поисковых систем.
	header /* {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}
