// Схема БД BusCom ERP. Модель данных описана в docs/PRD.md (раздел «Архитектура и стек»).
// Деньги — только Int в копейках (поля *Kopecks). Даты — timestamptz, UI показывает Europe/Moscow.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Пользователи и авторизация (таблицы user/session/account/verification — формат Better Auth)
// ---------------------------------------------------------------------------

/// Склада в компании нет, роли WAREHOUSE тоже — см. docs/DECISIONS.md
enum UserRole {
  MANAGER
  HEAD
  ADMIN
}

/// Функция сотрудника — отдельно от роли (роль даёт права, функция — участок работы).
/// Этапы цепочек поставщиков закрепляются за функцией, по ней вкладки списка заказов
enum JobFunction {
  MANAGER
  LOGIST
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  emailVerified      Boolean      @default(false)
  image              String?
  role               UserRole     @default(MANAGER)
  /// Функция: менеджер или логист; null — не задана
  jobFunction        JobFunction?
  isActive           Boolean      @default(true)
  /// Почта для уведомлений из личных настроек. null — не задана, уведомления идут на `email` входа
  notificationEmail  String?
  /// На что подписан: ключи тем из packages/domain/src/notification/topics.ts
  notificationTopics String[]     @default([])
  /// Сообщения чата до этого момента прочитаны; null — чат ещё не открывал
  chatReadAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sessions      Session[]
  notifications Notification[]
  accounts      Account[]
  managedOrders Order[]            @relation("OrderManager")
  orderEvents   OrderEvent[]
  payments      Payment[]
  sentEmails    Email[]
  chatMessages  ChatMessage[]
  chatReactions ChatReaction[]
  pushDevices   PushSubscription[]
  sitePages     SitePage[]
  expenses      Expense[]
  platformNews  PlatformNews[]
  newsReads     PlatformNewsRead[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Неудачные попытки входа. PRD, M8: после 10 неудачных за 15 минут вход по этому
/// email закрывается на 15 минут. В БД, а не в памяти процесса: счётчик должен
/// переживать перезапуск контейнера. Успешный вход строки по email удаляет.
model FailedLogin {
  id        String   @id @default(cuid())
  /// Email в нижнем регистре — в том же виде, в каком его ищет Better Auth
  email     String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// ---------------------------------------------------------------------------
// Клиенты
// ---------------------------------------------------------------------------

enum CustomerType {
  PERSON
  COMPANY
}

model Customer {
  id    String       @id @default(cuid())
  type  CustomerType @default(PERSON)
  /// Имя физлица или название юрлица — одно поле на оба случая
  name  String
  /// Нормализованный телефон в формате +7XXXXXXXXXX — ключ сопоставления и дублей.
  /// Уникален, но может быть пустым: у части клиентов телефона нет, и таких много
  /// (в Postgres UNIQUE не мешает нескольким NULL).
  phone String?      @unique
  /// Может повторяться: на несколько юрлиц бывает одна почта бухгалтерии
  email String?

  inn           String?
  kpp           String?
  /// Реквизиты юрлица (банк, р/с, руководитель и т.п.), форма — `CustomerRequisites`
  requisites    Json?
  /// Контактное лицо у юрлица: кому звонить, если в `name` название компании
  contactPerson String?
  /// Паспорт физлица одной строкой — как его записывали в прежней ERP
  passport      String?
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addresses CustomerAddress[]
  orders    Order[]
  emails    Email[]

  @@index([email])
  @@index([inn])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Адрес одной строкой: города отдельным полем не ведём — так приходит и с сайта,
  /// и из прежней ERP, а разбирать чужие строки на части всё равно нечем
  address    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Каталог
// ---------------------------------------------------------------------------

/// Каталог без количеств: склада нет, остаток и резерв не ведутся.
model Product {
  id              String           @id @default(cuid())
  sku             String           @unique
  name            String
  /// Описание с сайта, приведённое к тексту (абзацы переводом строки, пункты «• »).
  /// HTML не храним — docs/DECISIONS.md, «Описание товара»
  description     String?
  /// Категория из справочника (docs/DECISIONS.md, «Справочник категорий»)
  categoryId      String?
  category        ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priceKopecks    Int
  /// Совместимые модели авто: ["ГАЗель Next", "Ford Transit", ...]
  compatibility   String[]
  /// ID товара на bus-com.ru
  externalId      String?          @unique
  isActive        Boolean          @default(true)
  /// Адрес на сайте: bus-com.ru/{slug}. Общий с категориями — один уровень адресов.
  /// Не меняется при переименовании; смена руками — только с записью в UrlRedirect
  slug            String?          @unique
  /// Метатеги сайта. Пусто — шаблон из названия (docs/SITE-PRD.md, «Метатеги»)
  metaTitle       String?
  metaDescription String?
  /// Метка «Хит» на сайте: блок «Хиты продаж» на главной, первые места в категории
  isHit           Boolean          @default(false)
  /// Блок «Комплект на салон» в карточке на сайте: true — показывать, false — скрыть,
  /// null — автоматически (пассажирские сиденья, packages/domain/src/site/seats.ts)
  salonKit        Boolean?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  orderItems OrderItem[]
  suppliers  ProductSupplier[]
  options    ProductOption[]
  images     ProductImage[]
  redirects  UrlRedirect[]

  @@index([categoryId])
}

/// Категория товаров. Дерево: у подкатегории есть родитель («Климат» → «Люки»).
/// Правила — packages/domain/src/product/categories.ts. Категорию с товарами или
/// подкатегориями не удалить — её сначала освобождают.
model ProductCategory {
  id              String            @id @default(cuid())
  name            String
  parentId        String?
  parent          ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        ProductCategory[] @relation("CategoryTree")
  sortOrder       Int               @default(0)
  /// Адрес на сайте: bus-com.ru/{slug} — см. Product.slug
  slug            String?           @unique
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  products  Product[]
  redirects UrlRedirect[]

  @@index([parentId])
}

/// Текст статической страницы сайта, правленный в ERP (docs/SITE-PLAN.md, этап 6).
/// Набор страниц и исходный текст — packages/domain/src/site/pages.ts; строки нет —
/// сайт показывает исходный. Формат `body` — packages/domain/src/site/page-text.ts
model SitePage {
  slug            String   @id
  /// Заголовок h1
  title           String
  metaTitle       String
  metaDescription String?
  body            String
  updatedAt       DateTime @updatedAt
  updatedById     String?
  updatedBy       User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Переадресация старого адреса сайта (docs/SITE-PRD.md, «Адреса»). Цель — товар
/// или категория (тогда ведём на их текущий слуг и смена слуга ссылки не ломает),
/// иначе путь `toPath`. 410 — адрес убран насовсем, цели нет. Удалили товар или
/// категорию — ссылка обнуляется, и адрес ведёт на главную, а не в 404.
model UrlRedirect {
  id         String           @id @default(cuid())
  /// Путь со строкой запроса, без хвостового слэша: `/detali-salona/polki`,
  /// `/index.php?route=product/product&product_id=470`
  fromPath   String           @unique
  productId  String?
  product    Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  toPath     String?
  statusCode Int              @default(301)
  createdAt  DateTime         @default(now())

  @@index([productId])
  @@index([categoryId])
}

/// Картинка товара. Сейчас у товара одна — аватарка, но хранение сразу
/// множественное: первая по `sortOrder` и есть аватарка (docs/DECISIONS.md, «Картинки товара»).
/// Файлы лежат в базе: бэкапы и перенос в бой идут тем же путём, что и данные.
/// Байты выбирать только явно — в списках их не тянуть.
model ProductImage {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Порядок в галерее; наименьший — аватарка
  sortOrder        Int      @default(0)
  contentType      String
  data             Bytes
  byteSize         Int
  /// Уменьшенная копия для списков. Нет — показывается полная
  thumbData        Bytes?
  thumbContentType String?
  /// Откуда взята (адрес на bus-com.ru) — ключ повторного импорта; у загруженных руками пусто
  sourceUrl        String?
  /// Что было до обработки («Удалить знак / фон» в карточке товара) — чтобы вернуть.
  /// Пусто — картинку не обрабатывали. Хранится самый первый оригинал, а не промежуточные
  originalData        Bytes?
  originalContentType String?
  createdAt        DateTime @default(now())

  @@index([productId, sortOrder])
}

/// Группа опций товара: «Опора», «Ремень», «Выбор стекла». Покупатель выбирает
/// в группе один вариант, его надбавка прибавляется к цене товара. Правила — packages/domain/src/product/options.ts
model ProductOption {
  id         String               @id @default(cuid())
  productId  String
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  /// Без выбора в этой группе позицию в заказ не добавить
  required   Boolean              @default(false)
  sortOrder  Int                  @default(0)
  /// ID опции товара на сайте (product_option_id) — ключ повторного импорта
  externalId String?
  values     ProductOptionValue[]

  @@index([productId])
}

/// Вариант в группе опций. Надбавка — в копейках, прибавляется к цене товара.
/// Заказ ссылается на вариант снимком (`OrderItem.options`), а не ключом: правка
/// и удаление вариантов старые заказы не задевают.
model ProductOptionValue {
  id                String        @id @default(cuid())
  optionId          String
  option            ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  name              String
  priceDeltaKopecks Int           @default(0)
  sortOrder         Int           @default(0)
  /// ID варианта на сайте (product_option_value_id)
  externalId        String?

  /// Закупка этого варианта у поставщиков товара — «Подтянуть цены опций»
  supplierPrices ProductSupplierOptionPrice[]

  @@index([optionId])
}

// ---------------------------------------------------------------------------
// Поставщики
// ---------------------------------------------------------------------------

/// Поставщик товаров. Поля — как у клиента (физлицо или юрлицо), плюс своя
/// цепочка этапов работы: по ней идёт трек поставщика в заказе (docs/DECISIONS.md).
model Supplier {
  id            String       @id @default(cuid())
  type          CustomerType @default(COMPANY)
  name          String
  /// Нормализованный телефон +7XXXXXXXXXX. Не уникален: у поставщика бывает общий
  /// номер на несколько юрлиц, а сопоставлять по нему ничего не нужно
  phone         String?
  email         String?
  inn           String?
  kpp           String?
  /// Реквизиты юрлица — та же форма, что у клиента (`CustomerRequisites`)
  requisites    Json?
  contactPerson String?
  address       String?
  comment       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  /// Включённые действия/артефакты для заказа с этим поставщиком — ключи из
  /// фиксированного списка в packages/domain/src/supplier/actions.ts. По умолчанию —
  /// «Заказ поставщику»: раньше это была единственная и обязательная функция,
  /// значение по умолчанию бэкфилит уже заведённых поставщиков тем же составом.
  enabledActions String[] @default(["SUPPLIER_REQUEST"])

  /// «Экономика цены»: шаги от номинала к стоимости закупки для нас и расходы
  /// на заказ. Форма — `PriceFormula` в packages/domain/src/supplier/price-economics.ts;
  /// null — без надбавок, стоимость для нас равна номиналу
  priceFormula Json?

  /// «Комиссия с прибыли»: какую долю нашей прибыли по его товарам в заказе
  /// удерживает поставщик, сотые доли процента (2000 = 20%). 0 — не удерживает.
  /// Расчёт — packages/domain/src/order/margin.ts
  profitCommissionHundredths Int @default(0)

  stages     SupplierStage[]
  products   ProductSupplier[]
  orderItems OrderItem[]
  tracks     OrderSupplierTrack[]
  documents  OrderSupplierDocument[]

  @@index([name])
  @@index([inn])
}

/// Этап в цепочке работы с поставщиком: «Запрошен счёт», «Оплачено поставщику»…
/// Это подстатусы заказа «в работе» — порядок задаёт `sortOrder`.
model SupplierStage {
  id          String       @id @default(cuid())
  supplierId  String
  supplier    Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name        String
  sortOrder   Int
  /// Чей этап: заказ с треком на нём попадает во вкладку этой функции; null — ничей
  jobFunction JobFunction?
  createdAt   DateTime     @default(now())

  /// Этап, на котором стоит трек заказа, удалить нельзя — иначе заказ потерял бы место в цепочке
  tracks OrderSupplierTrack[]

  @@index([supplierId, sortOrder])
}

/// Товар у поставщика и закупочная цена. Цена продажи остаётся в `Product.priceKopecks`.
model ProductSupplier {
  productId            String
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId           String
  supplier             Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchasePriceKopecks Int
  /// Страница товара на сайте поставщика — чтобы свериться с ценой и наличием,
  /// не разыскивая её заново. Своя у каждой пары товар–поставщик
  url                  String?
  /// Выбранные варианты товара на странице поставщика ({ category: "заднее", … }),
  /// когда цена там зависит от выпадающих списков (packages/domain/src/product/vanproject.ts).
  /// По ним «Подтянуть цену» спрашивает цену именно этого варианта
  variant              Json?
  updatedAt            DateTime @updatedAt

  /// Закупка вариантов опций товара у этого поставщика
  optionPrices ProductSupplierOptionPrice[]

  @@id([productId, supplierId])
  @@index([supplierId])
}

/// Закупка варианта опции товара у поставщика. Закупка позиции в заказе — базовая
/// закупка пары товар–поставщик плюс закупки выбранных вариантов, как цена продажи
/// (packages/domain/src/product/option-matching.ts). Живёт, пока живы и пара, и вариант
model ProductSupplierOptionPrice {
  id                   String             @id @default(cuid())
  productId            String
  supplierId           String
  productSupplier      ProductSupplier    @relation(fields: [productId, supplierId], references: [productId, supplierId], onDelete: Cascade)
  optionValueId        String
  optionValue          ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)
  purchasePriceKopecks Int
  /// Какой вариант на странице поставщика сопоставлен ({ category: …, equipment: … })
  variant              Json?

  @@unique([productId, supplierId, optionValueId])
  @@index([optionValueId])
}

// ---------------------------------------------------------------------------
// Заказы
// ---------------------------------------------------------------------------

/// Переходы между статусами — только через packages/domain/src/order/status.ts.
/// Глобальных статусов четыре; промежуточные этапы — в цепочках поставщиков
/// (docs/DECISIONS.md, «Статусная модель упрощена»)
enum OrderStatus {
  /// «Создан»
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderSource {
  SITE
  PHONE
  EMAIL
  MESSENGER
  OTHER
  /// Заказ перенесён из прежней ERP скриптом импорта, а не заведён в этой системе
  LEGACY
}

enum DeliveryMethod {
  PICKUP
  CARRIER
  COURIER
}

model Order {
  id           String          @id @default(cuid())
  /// Человекочитаемый номер заказа (последовательность)
  number       Int             @unique @default(autoincrement())
  /// Технический канал: по нему идемпотентность интеграции `(source, externalId)`.
  /// Что видит пользователь — `sourceItem` из справочника источников
  source       OrderSource     @default(SITE)
  sourceItemId String?
  sourceItem   DictionaryItem? @relation(fields: [sourceItemId], references: [id], onDelete: Restrict)
  /// Номер/ID заказа во внешней системе (на сайте)
  externalId   String?
  /// Номер заказа на сайте — тот, что знает клиент (письма OpenCart «… - Заказ 2828»).
  /// У заказов с сайта совпадает с externalId, у архивных — «Номер» прежней ERP,
  /// у заведённых руками — null. По нему письмо клиента находит заказ
  siteNumber   String?
  status       OrderStatus     @default(NEW)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  managerId  String?
  manager    User?    @relation("OrderManager", fields: [managerId], references: [id])

  /// Итоги пересчитываются только на сервере из позиций (packages/domain/src/order/totals.ts)
  itemsTotalKopecks    Int @default(0)
  discountKopecks      Int @default(0)
  deliveryPriceKopecks Int @default(0)
  totalKopecks         Int @default(0)
  /// Сумма принятых платежей. Кэш для фильтра и сортировки по оплате: сам статус оплаты
  /// не хранится, его считает packages/domain/src/order/payment-status.ts из этой суммы и итога.
  paidKopecks          Int @default(0)

  deliveryMethod   DeliveryMethod?
  carrier          String?
  deliveryAddress  String?
  /// Снимок терминала ТК, выбранного покупателем из справочника (`TerminalSnapshot`,
  /// packages/domain/src/carrier/terminals.ts). Сбрасывается, когда меняют ТК или адрес
  deliveryTerminal Json?
  trackingNumber   String?
  /// Дата отгрузки: правится в карточке, при переходе в «Выполнен» ставится сама, если пусто
  shippedAt        DateTime?
  /// Дата доставки: когда груз будет у получателя (у ТК — готов к выдаче). Полночь по Москве;
  /// правится в карточке или подставляется из накладной
  deliveryDate     DateTime?
  /// Груз для ТК (M5): вес в граммах, стороны в сантиметрах — целыми, как деньги в копейках
  cargoWeightGrams Int?
  cargoLengthCm    Int?
  cargoWidthCm     Int?
  cargoHeightCm    Int?
  /// Объём груза в см³ (0,556 м³ = 556000)
  cargoVolumeCm3   Int?

  customerComment String?
  cancelReason    String?
  /// Время последней смены статуса — для расчёта SLA
  statusChangedAt DateTime  @default(now())
  /// Когда истекает SLA текущего статуса (рабочие минуты уже учтены при записи).
  /// null — статус без контроля срока. Нужен, чтобы фильтр «просроченные» был запросом,
  /// а не перебором заказов в приложении.
  slaDueAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items             OrderItem[]
  payments          Payment[]
  events            OrderEvent[]
  notifications     Notification[]
  supplierTracks    OrderSupplierTrack[]
  supplierDocuments OrderSupplierDocument[]
  documents         OrderDocument[]
  emails            Email[]

  @@unique([source, externalId])
  @@index([siteNumber])
  @@index([status])
  @@index([managerId])
  @@index([sourceItemId])
  @@index([customerId])
  @@index([createdAt])
  @@index([slaDueAt])
}

model OrderItem {
  id                   String    @id @default(cuid())
  orderId              String
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product?  @relation(fields: [productId], references: [id])
  /// Снимок товара на момент заказа — правки каталога не меняют старые заказы
  sku                  String
  name                 String
  priceKopecks         Int
  quantity             Int
  discountKopecks      Int       @default(0)
  sortOrder            Int       @default(0)
  /// У кого берём позицию. Поставщика с позициями в заказах удалить нельзя
  supplierId           String?
  supplier             Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// Снимок закупочной цены на момент выбора поставщика — как и цена продажи выше
  purchasePriceKopecks Int?
  /// Снимок стоимости закупки для нас за штуку: номинал выше + «Экономика цены»
  /// поставщика на тот же момент. Правка формулы старые заказы не меняет
  purchaseCostKopecks  Int?
  /// Снимок выбранных опций: [{ optionName, valueName, priceDeltaKopecks, valueId }].
  /// Форма — `OrderItemOption` в packages/domain/src/product/options.ts
  options              Json?

  @@index([orderId])
  @@index([supplierId])
}

/// Трек поставщика в заказе: на каком этапе его цепочки сейчас работа.
/// Один на пару заказ–поставщик; заводится и убирается вместе с позициями.
model OrderSupplierTrack {
  id                         String         @id @default(cuid())
  orderId                    String
  order                      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId                 String
  supplier                   Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// null — работа с поставщиком ещё не начата
  stageId                    String?
  stage                      SupplierStage? @relation(fields: [stageId], references: [id], onDelete: Restrict)
  /// Снимок расходов на заказ из «Экономики цены» поставщика — на момент, когда
  /// поставщик появился в заказе
  orderCostKopecks           Int            @default(0)
  /// Снимок комиссии с прибыли поставщика на тот же момент, сотые доли процента
  profitCommissionHundredths Int            @default(0)
  updatedAt                  DateTime       @updatedAt

  @@unique([orderId, supplierId])
  @@index([supplierId])
}

/// Артефакт по действию из packages/domain/src/supplier/actions.ts (сейчас — только
/// счёт поставщика, `kind: "SUPPLIER_INVOICE"`). Отдельно от `OrderSupplierTrack`
/// намеренно: тот трек удаляется, когда позиций этого поставщика в заказе не
/// осталось (syncSupplierTracks), а прикреплённый файл должен пережить это.
model OrderSupplierDocument {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  kind        String
  fileName    String
  contentType String
  data        Bytes
  byteSize    Int
  uploadedAt  DateTime @default(now())

  @@unique([orderId, supplierId, kind])
  @@index([orderId])
}

/// Файл самого заказа, не поставщика: транспортная накладная и т.п. Вид — ключ
/// из packages/domain/src/order/order-document.ts; у заказа один активный файл каждого вида.
model OrderDocument {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind        String
  fileName    String
  contentType String
  data        Bytes
  byteSize    Int
  uploadedAt  DateTime @default(now())

  @@unique([orderId, kind])
}

enum PaymentMethod {
  INVOICE
  ONLINE
  CASH
  COD
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  amountKopecks Int
  paidAt        DateTime
  /// № платёжного поручения, ID транзакции и т.п.
  reference     String?
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([orderId])
}

enum OrderEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  UPDATED
  ITEMS_CHANGED
  PAYMENT_ADDED
  COMMENT
  /// Трек поставщика перешёл на другой этап его цепочки
  SUPPLIER_STAGE_CHANGED
  /// Артефакт по поставщику прикреплён, заменён или удалён (OrderSupplierDocument)
  SUPPLIER_DOCUMENT_CHANGED
  /// Файл заказа прикреплён, заменён или удалён (OrderDocument): транспортная накладная и т.п.
  ORDER_DOCUMENT_CHANGED
  /// Письмо клиенту отправлено из карточки заказа (Email)
  EMAIL_SENT
  /// Письмо клиента пришло в общий ящик и привязано к заказу (Email)
  EMAIL_RECEIVED
}

/// Журнал заказа: история в карточке и аудит. Только добавление, без правок.
model OrderEvent {
  id         String         @id @default(cuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// null — действие системы (интеграция, автоматика)
  userId     String?
  user       User?          @relation(fields: [userId], references: [id])
  type       OrderEventType
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  comment    String?
  payload    Json?
  createdAt  DateTime       @default(now())

  @@index([orderId, createdAt])
}

/// Письмо-уведомление одному сотруднику. Пишется в той же транзакции, что и
/// событие (очередь), отправляется после — src/server/notifications/dispatch.ts.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ключ темы, по которой сотрудник подписан
  topic     String
  orderId   String?
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subject   String
  text      String
  createdAt DateTime  @default(now())
  /// Отправитель взял письмо в работу; зависшее дольше 10 минут берётся снова
  claimedAt DateTime?
  sentAt    DateTime?
  attempts  Int       @default(0)
  lastError String?

  @@index([sentAt, createdAt])
}

// ---------------------------------------------------------------------------
// Справочники и настройки (PRD, M8)
// ---------------------------------------------------------------------------

enum DictionaryType {
  /// Причины отмены заказа
  CANCEL_REASON
  /// Транспортные компании
  CARRIER
  /// Источники заказов: откуда пришёл заказ (телефон, Авито, выставка…)
  ORDER_SOURCE
  /// Модели авто для совместимости товара (`Product.compatibility` хранит их названия)
  CAR_MODEL
}

/// Простые списки, которые редактирует администратор. Позиции не удаляются
/// физически — гасятся `isActive`, иначе сломались бы ссылки в старых заказах.
model DictionaryItem {
  id         String         @id @default(cuid())
  type       DictionaryType
  name       String
  sortOrder  Int            @default(0)
  isActive   Boolean        @default(true)
  /// Системный источник заказа: его ставит интеграция (SITE) или импорт (LEGACY).
  /// Такой пункт можно переименовать, но нельзя выключить или выбрать руками
  systemCode OrderSource?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  orders Order[]

  @@unique([type, name])
  @@unique([type, systemCode])
  @@index([type, isActive])
}

/// Схемы салона (справочник «Схемы салонов», как в окне «Посчитать комплект» на сайте).
/// Из числа мест и подлокотников/откидных спинок считается цена комплекта пассажирского сиденья.
/// Как и у `DictionaryItem`, схему не удаляют, а гасят `isActive` — на неё будут ссылаться расчёты
model SalonLayout {
  id            String   @id @default(cuid())
  name          String   @unique
  /// Сколько пассажирских мест в схеме
  seats         Int
  /// Сколько сидений в схеме идёт с подлокотником
  armrests      Int      @default(0)
  /// Сколько сидений в схеме идёт с откидной спинкой
  reclinerBacks Int      @default(0)
  /// Чертёж схемы; лежит в базе, как картинки товаров. Нет — схема показывается без картинки
  imageData        Bytes?
  imageContentType String?
  /// Откуда взята (адрес на bus-com.ru) — по нему скрипт докачивает картинку
  imageSourceUrl   String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Перевозчики, у которых терминалы загружаются по API (docs/SITE-PLAN.md, этап 5а)
enum TerminalCarrier {
  DELLIN
  PEC
}

/// Терминалы и пункты транспортных компаний — из них покупатель выбирает пункт
/// получения. Обновляются раз в сутки из API перевозчика (src/server/carriers);
/// пропавший из выгрузки пункт гасится `isActive`, а не удаляется — в заказах
/// он хранится снимком, а не ссылкой.
model CarrierTerminal {
  id            String          @id @default(cuid())
  carrier       TerminalCarrier
  /// Код пункта у перевозчика
  externalId    String
  cityName      String
  /// Код города у перевозчика (у ДЛ — КЛАДР)
  cityCode      String?
  name          String
  address       String
  fullAddress   String?
  latitude      Float?
  longitude     Float?
  /// График выдачи груза текстом, как его отдаёт перевозчик
  schedule      String?
  phone         String?
  receivesCargo Boolean
  givesOutCargo Boolean
  /// Мелкий пункт выдачи (у ПЭК — ПВЗ с лимитом в десятки килограммов): покупателю не показывается,
  /// сиденья и крупные комплектующие туда не примут (решение владельца 29.09.2026)
  isPickupPoint Boolean         @default(false)
  /// Ограничения на одно место: вес в килограммах, стороны в сантиметрах
  maxWeightKg   Int?
  maxLengthCm   Int?
  maxWidthCm    Int?
  maxHeightCm   Int?
  isActive      Boolean         @default(true)
  /// Когда пункт последний раз пришёл в выгрузке перевозчика
  syncedAt      DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([carrier, externalId])
  @@index([carrier, isActive, cityName])
}

/// Настройки системы: одно значение на ключ, структура значения — за кодом
/// (src/server/settings). Значения по умолчанию живут в домене, здесь только
/// то, что администратор поменял.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ---------------------------------------------------------------------------
// Интеграция с сайтом
// ---------------------------------------------------------------------------

enum InboxStatus {
  PENDING
  PROCESSED
  FAILED
}

/// Сырые входящие события. Пишутся ДО разбора, чтобы заказ не терялся при ошибке маппинга.
model IntegrationInbox {
  id          String      @id @default(cuid())
  source      String
  externalId  String
  payload     Json
  status      InboxStatus @default(PENDING)
  error       String?
  attempts    Int         @default(0)
  orderId     String?
  receivedAt  DateTime    @default(now())
  processedAt DateTime?

  @@unique([source, externalId])
  @@index([status])
}

enum EmailDirection {
  /// Письмо клиента, пришедшее в общий ящик
  INBOUND
  /// Письмо клиенту, отправленное из ERP
  OUTBOUND
}

/// Переписка с клиентом по почте (PRD, M6.2). Входящие приходят из общего ящика
/// (тот же IMAP-опрос, что принимает заказы с сайта), исходящие уходят через SMTP.
/// Письмо без заказа — входящее, которое не удалось привязать: его привязывают руками
/// в разделе «Почта».
model Email {
  id         String         @id @default(cuid())
  direction  EmailDirection
  orderId    String?
  order      Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Message-ID без угловых скобок: у входящих — от почтового сервера клиента,
  /// у исходящих — наш. По нему узнаём ответы на наши письма и не принимаем письмо дважды
  messageId  String?        @unique
  /// Message-ID из In-Reply-To и References — цепочка, по которой ответ находит заказ
  references String[]       @default([])
  /// Адрес отправителя в нижнем регистре; имя — отдельно
  fromEmail  String
  fromName   String?
  toEmails   String[]
  subject    String
  /// Текст письма. У HTML-писем — текстовая версия, которую собирает mailparser
  body       String
  /// Шаблон, которым написано исходящее: invoice / paid / shipped (packages/domain/src/email/templates.ts)
  template   String?
  /// Кто отправил исходящее
  userId     String?
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Входящее прочитано в ERP; у исходящих всегда заполнено
  readAt     DateTime?
  /// Дата письма: у входящих — из заголовка Date, у исходящих — время отправки
  sentAt     DateTime
  /// Письмо перенесено импортом истории из ящика, а не пришло опросом или ушло из ERP.
  /// Такие сразу прочитаны, не ждут привязки во «Без заказа» и не пишут событий заказа
  importedAt DateTime?
  createdAt  DateTime       @default(now())

  attachments EmailAttachment[]

  @@index([orderId, sentAt])
  @@index([customerId])
  @@index([direction, readAt])
  @@index([sentAt])
}

/// Вложение письма. Файлы входящих больше лимита не храним — только отметку о них в `skippedReason`
model EmailAttachment {
  id            String  @id @default(cuid())
  emailId       String
  email         Email   @relation(fields: [emailId], references: [id], onDelete: Cascade)
  fileName      String
  contentType   String
  byteSize      Int
  /// null — файл не сохранён (слишком большой); причина — в `skippedReason`
  data          Bytes?
  skippedReason String?

  @@index([emailId])
}

// ---------------------------------------------------------------------------
// Чат сотрудников: один общий канал
// ---------------------------------------------------------------------------

/// Сообщение общего чата. Удалённое не стирается строкой — остаётся с `deletedAt`
/// и пустым текстом, чтобы в ленте было видно «сообщение удалено».
/// `updatedAt` — курсор опроса: по нему клиент получает новые, исправленные и удалённые.
model ChatMessage {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  text      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?
  /// Сообщение, на которое это — ответ. Исходное удаляется мягко, так что ссылка
  /// остаётся; SetNull — на случай, если строку когда-нибудь сотрут физически
  replyToId String?
  replyTo   ChatMessage?  @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatReply")

  attachments ChatAttachment[]
  reactions   ChatReaction[]

  @@index([createdAt])
  @@index([updatedAt])
}

/// Новости платформы: журнал новых возможностей ERP и сайта. Читают все сотрудники, пишет администратор
model PlatformNews {
  id          String   @id @default(cuid())
  title       String
  /// Обычный текст: абзацы — пустой строкой, адреса становятся ссылками
  body        String
  publishedAt DateTime @default(now())
  /// Кто написал; у записей, засеянных миграцией, пусто
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reads PlatformNewsRead[]

  @@index([publishedAt])
}

/// Отметка «прочитано»: сотрудник видел запись. Нет строки — для него запись новая
model PlatformNewsRead {
  newsId String
  news   PlatformNews @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt DateTime     @default(now())

  @@id([newsId, userId])
  @@index([userId])
}

/// Реакция сотрудника на сообщение чата (эмодзи). Повторное нажатие её снимает — строка удаляется.
/// При постановке и снятии `ChatMessage.updatedAt` обновляется: по нему лента опрашивает изменения
model ChatReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

/// Файл в сообщении чата. Через год байты стираются (`data` = null, `expiredAt`),
/// а запись остаётся — в ленте видно, что файл был
model ChatAttachment {
  id          String      @id @default(cuid())
  messageId   String
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName    String
  contentType String
  byteSize    Int
  data        Bytes?
  createdAt   DateTime    @default(now())
  expiredAt   DateTime?

  @@index([messageId])
  @@index([createdAt])
}

/// Устройство, на которое сотрудник включил пуш-уведомления (браузер телефона или
/// компьютера). Адрес `endpoint` выдаёт сервис пушей браузера (Google, Apple, Mozilla);
/// `p256dh` и `auth` — ключи шифрования: текст уведомления сервис пушей не видит.
/// Подписка, от которой сервис отказался (404/410), удаляется при отправке.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  /// Браузер и система — чтобы сотрудник узнал своё устройство в списке
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Аналитика: расходы
// ---------------------------------------------------------------------------

/// Как часто повторяется расход с фиксированной суммой
enum ExpenseRecurrence {
  /// Разовый: вся сумма — в день `startsOn`
  ONCE
  MONTHLY
  QUARTERLY
  YEARLY
}

/// От какой величины аналитики считается расход-процент
enum ExpenseBase {
  /// Выручка: итоги выполненных заказов по дате выполнения
  REVENUE
  /// Маржа выполненных заказов, где она известна
  MARGIN
  /// Поступившие оплаты по дате платежа
  PAYMENTS
}

/// Расход компании для экрана «Аналитика»: сумма или процент от величины аналитики.
/// Регулярная сумма раскладывается равномерно (годовой — по 1/12 в месяц, внутри
/// месяца — по дням), процент берётся от величины за те дни периода, когда расход
/// действует. Как считается — packages/domain/src/analytics/expenses.ts.
///
/// Ровно один вид: сумма (`amountKopecks` + `recurrence`) или процент
/// (`percentHundredths` + `base`, без `recurrence`) — проверяется в миграции.
model Expense {
  id                String             @id @default(cuid())
  name              String
  comment           String?
  /// null — процент: он начисляется за каждый день действия, периодичности у него нет
  recurrence        ExpenseRecurrence?
  amountKopecks     Int?
  /// Сотые доли процента: 550 — 5,5%
  percentHundredths Int?
  base              ExpenseBase?
  /// Полночь по Москве. У разового — дата расхода, у остальных — первый день действия
  startsOn          DateTime
  /// Последний день действия включительно (полночь по Москве); null — бессрочно
  endsOn            DateTime?
  createdById       String?
  createdBy         User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([startsOn])
}
