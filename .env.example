# Скопировать в .env и заполнить. Каждая переменная валидируется в src/server/env.ts.

# Общая база разработки на сервере — одна на все машины (docs/DEV-DB.md).
# Работает через SSH-туннель: сначала `pnpm db:tunnel`, порт 5433.
# Пароль роли buscom_dev — у владельца проекта.
DATABASE_URL="postgresql://buscom_dev:пароль@localhost:5433/buscom_erp_dev?schema=public"

# Запасной путь — локальная БД (docker-compose.yml или нативный Postgres):
# DATABASE_URL="postgresql://buscom:buscom@localhost:5432/buscom_erp?schema=public"

# Куда `pnpm db:pull` кладёт копию общей базы — та же локальная база.
# Нужна только для этой команды, приложение её не читает.
LOCAL_DATABASE_URL="postgresql://buscom:buscom@localhost:5432/buscom_erp?schema=public"

# Better Auth: секрет генерировать командой `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# HMAC-секрет для вебхуков сайта bus-com.ru (≥ 32 символа)
SITE_WEBHOOK_SECRET=""

# Первый администратор, создаётся скриптом `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@bus-com.ru
SEED_ADMIN_NAME=Администратор
SEED_ADMIN_PASSWORD=change-me-please

# SMTP для писем со сбросом пароля. Не задан — ссылка печатается в лог сервера
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Баском ERP <noreply@bus-com.ru>"

#ключ от сервиса подтягинвания данных по ИНН
DADATA_API_KEY="ключи из ЛК dadata.ru"

# IMAP для подтягивания писем с заказами
IMAP_HOST=mail.jino.ru
IMAP_PORT=993
IMAP_USER=zakaz@erp.bus-com.ru
IMAP_PASSWORD='пароль с jino'