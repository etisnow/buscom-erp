# Скопировать в .env и заполнить. Каждая переменная валидируется в src/server/env.ts.

# Локально — БД из docker-compose.yml
DATABASE_URL="postgresql://buscom:buscom@localhost:5432/buscom_erp?schema=public"

# Better Auth: секрет генерировать командой `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# HMAC-секрет для вебхуков сайта bus-com.ru (≥ 32 символа)
SITE_WEBHOOK_SECRET=""

# Первый администратор, создаётся скриптом `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@bus-com.ru
SEED_ADMIN_NAME=Администратор
SEED_ADMIN_PASSWORD=change-me-please
