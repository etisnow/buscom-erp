# Сайт bus-com.ru. Переменные — apps/site/src/env.ts

# Общая с ERP база. На машине разработки — через туннель, как у ERP (docs/DEV-DB.md)
DATABASE_URL="postgresql://buscom_dev:пароль@localhost:5433/buscom_erp_dev?schema=public"

# Адрес сайта без слэша на конце: canonical, sitemap.xml, robots.txt
SITE_URL=http://localhost:3001

# Открыт ли сайт поисковикам. До переключения DNS — false (docs/SITE-PLAN.md, этап 9)
SITE_INDEXING=false
