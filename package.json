{
  "name": "buscom-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:up": "docker compose up -d postgres",
    "db:tunnel": "tsx --tsconfig tsconfig.scripts.json scripts/db-tunnel.ts",
    "db:pull": "tsx --tsconfig tsconfig.scripts.json scripts/db-pull.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "import:customers": "tsx --tsconfig tsconfig.scripts.json scripts/import-customers.ts",
    "import:orders": "tsx --tsconfig tsconfig.scripts.json scripts/import-orders.ts",
    "fetch:site-products": "tsx --tsconfig tsconfig.scripts.json scripts/fetch-site-products.ts",
    "import:site-products": "tsx --tsconfig tsconfig.scripts.json scripts/import-site-products.ts",
    "mail:poll": "tsx --tsconfig tsconfig.scripts.json scripts/mail-poll.ts",
    "fetch:emails": "tsx --tsconfig tsconfig.scripts.json scripts/fetch-emails.ts",
    "import:site-images": "tsx --tsconfig tsconfig.scripts.json scripts/import-site-images.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "@types/pdfmake": "^0.3.3",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "imapflow": "^2.0.5",
    "lucide-react": "^1.47.0",
    "mailparser": "^3.9.28",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.3.4"
}
