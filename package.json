{
  "name": "buscom",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @buscom/erp dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm format:check && pnpm -r check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:tunnel": "tsx scripts/db-tunnel.ts",
    "erp": "pnpm --filter @buscom/erp"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.13",
    "@types/node": "^20",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.3.4"
}
