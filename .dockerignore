# Что не должно попасть в контекст сборки.

# Секреты. Важно: next build копирует найденный .env внутрь .next/standalone,
# то есть без этой строки боевые ключи уехали бы в образ. Проверено на живой
# сборке — .env действительно оказывается в standalone-выводе.
**/.env
**/.env.*
!**/.env.example

# Ставится внутри образа под его платформу
**/node_modules
.pnpm-store

# Результаты сборки с машины разработчика
**/.next
out
build
coverage
*.tsbuildinfo
next-env.d.ts

# Генерируется в образе через postinstall
**/src/generated
**/misc

# История и инструменты — образу не нужны
.git
.github
.gitignore
.idea
.vscode
.claude
docs
docker-compose.yml
docker-compose.prod.yml
Dockerfile
.dockerignore
README.md
*.log
